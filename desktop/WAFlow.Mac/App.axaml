<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WAFlow.Mac.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#15251E" />
    <SolidColorBrush x:Key="InkSecondary" Color="#43564D" />
    <SolidColorBrush x:Key="Muted" Color="#586B64" />
    <SolidColorBrush x:Key="MutedSubtle" Color="#96A8A1" />
    <SolidColorBrush x:Key="Primary" Color="#087A59" />
    <SolidColorBrush x:Key="PrimaryDark" Color="#066A4D" />
    <SolidColorBrush x:Key="PrimaryHover" Color="#066A4D" />
    <SolidColorBrush x:Key="OnPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimarySoft" Color="#D9F5EB" />
    <SolidColorBrush x:Key="PrimarySurface" Color="#ECFAF5" />
    <SolidColorBrush x:Key="AiAccent" Color="#6659B8" />
    <SolidColorBrush x:Key="AiAccentDeep" Color="#51459F" />
    <SolidColorBrush x:Key="OnAi" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AiProcessing" Color="#31C8E5" />
    <SolidColorBrush x:Key="AiSoft" Color="#E8E3FF" />
    <SolidColorBrush x:Key="AiSurface" Color="#F4F1FF" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceElevated" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceMuted" Color="#F4F7F5" />
    <SolidColorBrush x:Key="SurfaceInput" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Canvas" Color="#F4F7F5" />
    <SolidColorBrush x:Key="CanvasDeep" Color="#E8EEEB" />
    <SolidColorBrush x:Key="Line" Color="#DDE5E1" />
    <SolidColorBrush x:Key="LineStrong" Color="#B9C9C3" />
    <SolidColorBrush x:Key="Sidebar" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarElevated" Color="#F1F6F3" />
    <SolidColorBrush x:Key="SidebarHover" Color="#EAF4EF" />
    <SolidColorBrush x:Key="SidebarActive" Color="#E1F1EA" />
    <SolidColorBrush x:Key="SidebarText" Color="#24362F" />
    <SolidColorBrush x:Key="SidebarMuted" Color="#586B64" />
    <SolidColorBrush x:Key="LogoSurface" Color="#EEF2F0" />
    <SolidColorBrush x:Key="LogoBorder" Color="#D6DEDA" />
    <SolidColorBrush x:Key="UnreadBadgeBackground" Color="#C43131" />
    <SolidColorBrush x:Key="UnreadBadgeText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Success" Color="#16B889" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#E0F7EF" />
    <SolidColorBrush x:Key="Warning" Color="#8A5A00" />
    <SolidColorBrush x:Key="WarningSoft" Color="#FFF2D6" />
    <SolidColorBrush x:Key="Danger" Color="#A52D2D" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FDE7E7" />
    <SolidColorBrush x:Key="OnDanger" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Info" Color="#4E8CF7" />
    <SolidColorBrush x:Key="InfoSoft" Color="#E9F1FF" />
    <SolidColorBrush x:Key="GradeA" Color="#16B889" />
    <SolidColorBrush x:Key="GradeB" Color="#4E8CF7" />
    <SolidColorBrush x:Key="GradeC" Color="#E0A12B" />
    <SolidColorBrush x:Key="GradeD" Color="#83958E" />
    <SolidColorBrush x:Key="ChatOutbound" Color="#D1F5E8" />
    <SolidColorBrush x:Key="ChatInbound" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Overlay" Color="#B80A1813" />
    <SolidColorBrush x:Key="GlassSurface" Color="#EFFFFFFF" />
    <SolidColorBrush x:Key="GlassSurfaceStrong" Color="#F8FFFFFF" />
    <SolidColorBrush x:Key="GlassLine" Color="#90D9E0DD" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="SF Pro Text, PingFang SC, Microsoft YaHei UI, Inter" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Background" Value="{DynamicResource Canvas}" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="17,9" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PrimarySurface}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.86" />
    </Style>
    <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AiAccent}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource Primary}" />
      <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PrimaryHover}" />
    </Style>
    <Style Selector="Button.ai">
      <Setter Property="Background" Value="{DynamicResource AiAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAi}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AiAccent}" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{DynamicResource Danger}" />
      <Setter Property="Foreground" Value="{DynamicResource OnDanger}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
    </Style>

    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Height" Value="44" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Width" Value="224" />
      <Setter Property="Padding" Value="13,10" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SidebarHover}" />
    </Style>
    <Style Selector="Button.nav.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SidebarActive}" />
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav Path">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>
    <Style Selector="Button.nav Rectangle">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>
    <Style Selector="Button.nav Ellipse.icon-stroke">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>
    <Style Selector="Button.nav Ellipse.icon-fill">
      <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="11,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource PrimarySoft}" />
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    </Style>
    <Style Selector="TextBox:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource AiAccent}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
    </Style>
    <Style Selector="ComboBox:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource AiAccent}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{DynamicResource Primary}" />
      <Setter Property="Background" Value="{DynamicResource CanvasDeep}" />
      <Setter Property="MinHeight" Value="6" />
    </Style>

    <Style Selector="TextBlock.sidebar-reveal">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="StackPanel.sidebar-reveal">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.sidebar-reveal">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#SidebarHost.expanded TextBlock.sidebar-reveal">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" Delay="0:0:0.06" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#SidebarHost.expanded StackPanel.sidebar-reveal">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" Delay="0:0:0.06" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#SidebarHost.expanded Border.sidebar-reveal">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" Delay="0:0:0.06" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#SidebarHost">
      <Setter Property="Width" Value="60" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.22" Easing="SineEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#SidebarHost.expanded">
      <Setter Property="Width" Value="240" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.24" Easing="SineEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window.reduce-motion Border#SidebarHost">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window.reduce-motion TextBlock.sidebar-reveal">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window.reduce-motion StackPanel.sidebar-reveal">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window.reduce-motion Border.sidebar-reveal">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window.reduce-motion ContentControl#ContentHost">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0" />
        </Transitions>
      </Setter>
    </Style>
  </Application.Styles>
</Application>
