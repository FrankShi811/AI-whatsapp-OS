<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WAFlow.Mac.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter, PingFang SC, Helvetica Neue, sans-serif" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="Button:focus /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="#37D6AA" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Height" Value="46" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#DDEFE8" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1D5445" />
    </Style>
    <Style Selector="Button.nav.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#1B5E4C" />
      <Setter Property="BorderBrush" Value="#36D7AA" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#0B9B75" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="18,10" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#FFF0EE" />
      <Setter Property="Foreground" Value="#B42318" />
      <Setter Property="BorderBrush" Value="#F6CBC5" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
  </Application.Styles>
</Application>
