<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WAFlow.Mac.MainWindow"
        Title="AI Sales OS · WhatsApp 销售智能"
        Width="1440" Height="900" MinWidth="1120" MinHeight="700"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Canvas}"
        KeyDown="MainWindow_KeyDown">
  <LayoutTransformControl x:Name="MainScaleHost">
  <Grid ColumnDefinitions="60,*" Background="{DynamicResource Canvas}">
    <!-- Windows v5.10.1 parity: the canvas always starts at x=60; navigation expands above it. -->
    <Border x:Name="SidebarHost"
            Grid.Column="0" Grid.ColumnSpan="2" ZIndex="40"
            HorizontalAlignment="Left"
            Background="{DynamicResource Sidebar}"
            BorderBrush="{DynamicResource Line}"
            BorderThickness="0,0,1,0"
            ClipToBounds="True"
            PointerEntered="SidebarHost_PointerEntered"
            PointerExited="SidebarHost_PointerExited"
            GotFocus="SidebarHost_GotFocus"
            LostFocus="SidebarHost_LostFocus">
      <Grid Width="240" HorizontalAlignment="Left" Margin="8,14,8,12"
            RowDefinitions="Auto,24,*,Auto">
        <Grid ColumnDefinitions="44,*">
          <Border Width="42" Height="42"
                  Background="{DynamicResource LogoSurface}"
                  BorderBrush="{DynamicResource LogoBorder}"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="5">
            <Image Source="avares://AISalesOS.Mac/Assets/AI-Sales-OS.png" Stretch="Uniform" />
          </Border>
          <StackPanel Grid.Column="1" Margin="11,1,0,0" VerticalAlignment="Center"
                      Classes="sidebar-reveal">
            <TextBlock Text="AI Sales OS" Foreground="{DynamicResource SidebarText}"
                       FontWeight="Bold" FontSize="16" TextWrapping="NoWrap" />
            <TextBlock Text="SALES INTELLIGENCE" Foreground="{DynamicResource SidebarMuted}"
                       FontSize="8.5" FontWeight="SemiBold" />
          </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="COMMAND CENTER" Classes="sidebar-reveal"
                       Foreground="{DynamicResource SidebarMuted}"
                       FontSize="9" FontWeight="SemiBold" Margin="13,3,0,7" />
            <Button x:Name="DashboardNav" Classes="nav selected" Tag="dashboard"
                    Click="Navigate_Click" ToolTip.Tip="销售指挥中心"
                    AutomationProperties.Name="销售指挥中心">
              <Grid ColumnDefinitions="28,*">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Rectangle Canvas.Left="3" Canvas.Top="3" Width="7" Height="9" RadiusX="1" RadiusY="1" Fill="Transparent" StrokeThickness="2" />
                    <Rectangle Canvas.Left="14" Canvas.Top="3" Width="7" Height="5" RadiusX="1" RadiusY="1" Fill="Transparent" StrokeThickness="2" />
                    <Rectangle Canvas.Left="14" Canvas.Top="12" Width="7" Height="9" RadiusX="1" RadiusY="1" Fill="Transparent" StrokeThickness="2" />
                    <Rectangle Canvas.Left="3" Canvas.Top="16" Width="7" Height="5" RadiusX="1" RadiusY="1" Fill="Transparent" StrokeThickness="2" />
                  </Canvas>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="Dashboard" Classes="sidebar-reveal" VerticalAlignment="Center" TextWrapping="NoWrap" />
              </Grid>
            </Button>
            <Button x:Name="IntelligenceNav" Classes="nav" Tag="intelligence"
                    Click="Navigate_Click" ToolTip.Tip="商机智能"
                    AutomationProperties.Name="商机智能">
              <Grid ColumnDefinitions="28,*">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Data="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z M9 13a4.5 4.5 0 0 0 3-4 M6.003 5.125A3 3 0 0 0 6.401 6.5 M3.477 10.896a4 4 0 0 1 .585-.396 M6 18a4 4 0 0 1-1.967-.516 M12 13h4 M12 18h6a2 2 0 0 1 2 2v1 M12 8h8 M16 8V5a2 2 0 0 1 2-2" Fill="Transparent" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                    <Ellipse Canvas.Left="15" Canvas.Top="12" Width="2" Height="2" Classes="icon-fill" />
                    <Ellipse Canvas.Left="17" Canvas.Top="2" Width="2" Height="2" Classes="icon-fill" />
                    <Ellipse Canvas.Left="19" Canvas.Top="20" Width="2" Height="2" Classes="icon-fill" />
                    <Ellipse Canvas.Left="19" Canvas.Top="7" Width="2" Height="2" Classes="icon-fill" />
                  </Canvas>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="商机智能" Classes="sidebar-reveal" VerticalAlignment="Center" TextWrapping="NoWrap" />
              </Grid>
            </Button>

            <TextBlock Text="CUSTOMER OPERATIONS" Classes="sidebar-reveal"
                       Foreground="{DynamicResource SidebarMuted}"
                       FontSize="9" FontWeight="SemiBold" Margin="13,20,0,7" />
            <Button x:Name="CustomersNav" Classes="nav" Tag="customers"
                    Click="Navigate_Click" ToolTip.Tip="客户列表"
                    AutomationProperties.Name="客户列表">
              <Grid ColumnDefinitions="28,*">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Data="M16 2v2 M17.915 22a6 6 0 0 0-12 0 M8 2v2" Fill="Transparent" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                    <Ellipse Canvas.Left="8" Canvas.Top="8" Width="8" Height="8" Classes="icon-stroke" Fill="Transparent" StrokeThickness="2" />
                    <Rectangle Canvas.Left="3" Canvas.Top="4" Width="18" Height="18" RadiusX="2" RadiusY="2" Fill="Transparent" StrokeThickness="2" />
                  </Canvas>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="客户列表" Classes="sidebar-reveal" VerticalAlignment="Center" TextWrapping="NoWrap" />
              </Grid>
            </Button>
            <Button x:Name="WhatsAppNav" Classes="nav" Tag="inbox"
                    Click="Navigate_Click" ToolTip.Tip="WhatsApp Inbox"
                    AutomationProperties.Name="WhatsApp Inbox">
              <Grid ColumnDefinitions="28,*,Auto">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Data="M12 8V4H8 M2 14h2 M20 14h2 M15 13v2 M9 13v2" Fill="Transparent" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                    <Rectangle Canvas.Left="4" Canvas.Top="8" Width="16" Height="12" RadiusX="2" RadiusY="2" Fill="Transparent" StrokeThickness="2" />
                  </Canvas>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="WhatsApp Inbox" Classes="sidebar-reveal" VerticalAlignment="Center" TextWrapping="NoWrap" />
                <Border x:Name="WhatsAppUnreadBadge" Grid.Column="2"
                        MinWidth="22" Height="20" Margin="8,0,0,0" Padding="6,0"
                        CornerRadius="10" Background="{DynamicResource UnreadBadgeBackground}"
                        IsVisible="False" Classes="sidebar-reveal">
                  <TextBlock x:Name="WhatsAppUnreadText" Foreground="{DynamicResource UnreadBadgeText}"
                             FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Button>
            <Button x:Name="EmailNav" Classes="nav" Tag="email"
                    Click="Navigate_Click" ToolTip.Tip="邮件 Inbox"
                    AutomationProperties.Name="邮件 Inbox">
              <Grid ColumnDefinitions="28,*,Auto">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Rectangle Canvas.Left="2" Canvas.Top="4" Width="20" Height="16" RadiusX="2" RadiusY="2" Fill="Transparent" StrokeThickness="2" />
                    <Path Data="M22 7l-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" Fill="Transparent" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                  </Canvas>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="邮件 Inbox" Classes="sidebar-reveal" VerticalAlignment="Center" TextWrapping="NoWrap" />
                <Border x:Name="EmailUnreadBadge" Grid.Column="2"
                        MinWidth="22" Height="20" Margin="8,0,0,0" Padding="6,0"
                        CornerRadius="10" Background="{DynamicResource UnreadBadgeBackground}"
                        IsVisible="False" Classes="sidebar-reveal">
                  <TextBlock x:Name="EmailUnreadText" Foreground="{DynamicResource UnreadBadgeText}"
                             FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Button>
            <Button x:Name="CampaignsNav" Classes="nav" Tag="broadcast"
                    Click="Navigate_Click" ToolTip.Tip="多渠道自动化触达"
                    AutomationProperties.Name="多渠道自动化触达">
              <Grid ColumnDefinitions="28,*">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Data="M3 11l18-5v12L3 14v-3z M11.6 16.8a3 3 0 1 1-5.8-1.6" Fill="Transparent" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                  </Canvas>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="自动化群发" Classes="sidebar-reveal" VerticalAlignment="Center" TextWrapping="NoWrap" />
              </Grid>
            </Button>

            <TextBlock Text="INSIGHTS" Classes="sidebar-reveal"
                       Foreground="{DynamicResource SidebarMuted}"
                       FontSize="9" FontWeight="SemiBold" Margin="13,20,0,7" />
            <Button x:Name="KnowledgeNav" Classes="nav" Tag="knowledge"
                    Click="Navigate_Click" ToolTip.Tip="知识库"
                    AutomationProperties.Name="知识库">
              <Grid ColumnDefinitions="28,*">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Data="M12 7v14 M16 12h2 M16 8h2 M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z M6 12h2 M6 8h2" Fill="Transparent" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                  </Canvas>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="知识库" Classes="sidebar-reveal" VerticalAlignment="Center" TextWrapping="NoWrap" />
              </Grid>
            </Button>
            <Button x:Name="AnalyticsNav" Classes="nav" Tag="analytics"
                    Click="Navigate_Click" ToolTip.Tip="客户智能分析"
                    AutomationProperties.Name="客户智能分析">
              <Grid ColumnDefinitions="28,*">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Data="M3 3v16a2 2 0 0 0 2 2h16 M18 17V9 M13 17V5 M8 17v-3" Fill="Transparent" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                  </Canvas>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="客户智能分析" Classes="sidebar-reveal" VerticalAlignment="Center" TextWrapping="NoWrap" />
              </Grid>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="3" x:Name="SettingsNav" Classes="nav" Tag="settings"
                Click="Settings_Click" Margin="0,0,0,9"
                ToolTip.Tip="设置 AI 模型、界面缩放、主题与本地体验"
                AutomationProperties.Name="设置">
          <Grid ColumnDefinitions="28,*">
            <Viewbox Width="18" Height="18">
              <Canvas Width="24" Height="24">
                <Path Data="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.83 2.83-.06-.06a1.7 1.7 0 0 0-1.88-.34 1.7 1.7 0 0 0-1.03 1.57V21h-4v-.08a1.7 1.7 0 0 0-1.03-1.57 1.7 1.7 0 0 0-1.88.34l-.06.06-2.83-2.83.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-1.57-1.03H3v-4h.08A1.7 1.7 0 0 0 4.65 8.94a1.7 1.7 0 0 0-.34-1.88L4.25 7l2.83-2.83.06.06a1.7 1.7 0 0 0 1.88.34A1.7 1.7 0 0 0 10.05 3H10V3h4v.08a1.7 1.7 0 0 0 1.03 1.57 1.7 1.7 0 0 0 1.88-.34l.06-.06 2.83 2.83-.06.06a1.7 1.7 0 0 0-.34 1.88 1.7 1.7 0 0 0 1.57 1.03H21v4h-.08A1.7 1.7 0 0 0 19.4 15z" Fill="Transparent" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
              </Canvas>
            </Viewbox>
            <TextBlock Grid.Column="1" Text="设置" Classes="sidebar-reveal" VerticalAlignment="Center" TextWrapping="NoWrap" />
          </Grid>
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="72,*">
      <Border Background="{DynamicResource SurfaceElevated}"
              BorderBrush="{DynamicResource Line}"
              BorderThickness="0,0,0,1">
        <Grid Margin="28,0,26,0" ColumnDefinitions="*,Auto">
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="PageSubtitle" Text="今天最值得推进的商机与动作"
                       Foreground="{DynamicResource Muted}" FontSize="10.5" Margin="0,2,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="9">
            <Border x:Name="ProviderBadge" Background="{DynamicResource WarningSoft}"
                    CornerRadius="13" Padding="11,6">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="✦" Foreground="{DynamicResource AiAccent}" />
                <TextBlock x:Name="AiStateText" Text="AI API 未配置"
                           Foreground="{DynamicResource Warning}" FontSize="10.5" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Button x:Name="PageGuideButton" Content="本页使用手册"
                    Click="ShowGuide_Click"
                    ToolTip.Tip="查看当前模块的功能介绍和操作步骤" />
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer x:Name="PageScroll" Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    SizeChanged="PageScroll_SizeChanged">
        <ContentControl x:Name="ContentHost"
                        Margin="28,24,26,32"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
          <ContentControl.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.235" Easing="CubicEaseOut" />
            </Transitions>
          </ContentControl.Transitions>
        </ContentControl>
      </ScrollViewer>
    </Grid>

    <Grid x:Name="CommandOverlay"
          Grid.ColumnSpan="2" ZIndex="120"
          Background="{DynamicResource Overlay}"
          IsVisible="False" Opacity="0"
          PointerPressed="CommandOverlay_PointerPressed">
      <Border x:Name="CommandPanel"
              Width="600" VerticalAlignment="Top"
              Margin="0,105,0,0"
              Background="{DynamicResource SurfaceElevated}"
              BorderBrush="{DynamicResource Line}"
              BorderThickness="1"
              CornerRadius="16"
              Padding="0"
              PointerPressed="CommandPanel_PointerPressed">
        <Grid RowDefinitions="Auto,Auto,Auto">
          <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="20,17">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Text="⌕" FontSize="20" Foreground="{DynamicResource AiAccent}" Margin="0,0,12,0" />
              <TextBlock Grid.Column="1" Text="快速前往或执行操作" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Border Grid.Column="2" Background="{DynamicResource CanvasDeep}" CornerRadius="5" Padding="6,2">
                <TextBlock Text="ESC" FontSize="9" Foreground="{DynamicResource Muted}" />
              </Border>
            </Grid>
          </Border>
          <StackPanel Grid.Row="1" Margin="10,10,10,4">
            <TextBlock Text="建议操作" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource AiAccent}" Margin="12,4,0,7" />
            <Button x:Name="FirstQuickActionButton" Classes="ghost" Tag="import" Click="QuickAction_Click"
                    HorizontalContentAlignment="Stretch">
              <Grid ColumnDefinitions="32,*,Auto">
                <TextBlock Text="＋" FontSize="18" Foreground="{DynamicResource Primary}" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="导入客户数据" FontWeight="SemiBold" />
                  <TextBlock Text="保留 Excel / CSV 原始字段" Foreground="{DynamicResource Muted}" FontSize="10" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="Enter" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="ghost" Tag="intelligence" Click="QuickAction_Click" Content="✦  打开商机智能" HorizontalContentAlignment="Left" />
            <Button Classes="ghost" Tag="inbox" Click="QuickAction_Click" Content="◉  打开 WhatsApp Inbox" HorizontalContentAlignment="Left" />
            <Button Classes="ghost" Tag="broadcast" Click="QuickAction_Click" Content="◌  建立自动化群发任务" HorizontalContentAlignment="Left" />
            <Button Classes="ghost" Tag="knowledge" Click="QuickAction_Click" Content="▤  管理业务知识与 RAG" HorizontalContentAlignment="Left" />
            <Button Classes="ghost" Tag="analytics" Click="QuickAction_Click" Content="◫  生成客户情报报告" HorizontalContentAlignment="Left" />
          </StackPanel>
          <Border Grid.Row="2" Background="{DynamicResource SurfaceMuted}" CornerRadius="0,0,16,16" Padding="20,11">
            <TextBlock Text="⌘1…8 切换模块 · ⌘K 打开 · Esc 关闭"
                       Foreground="{DynamicResource Muted}" FontSize="9.5" />
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
  </LayoutTransformControl>
</Window>
