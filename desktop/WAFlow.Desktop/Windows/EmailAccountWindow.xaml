<Window x:Class="WAFlow.Desktop.Windows.EmailAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连接邮件账号" Width="760" Height="820" MinWidth="650" MinHeight="700"
        WindowStartupLocation="CenterOwner" Icon="/Assets/AI-Sales-OS.ico" Background="{DynamicResource Canvas}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="连接邮件账号" Style="{StaticResource PageTitle}" FontSize="26"/>
            <TextBlock Text="选择平台后按专属步骤准备凭据；服务器参数会自动带出，密码只保存到 Windows 凭据管理器。"
                       Foreground="{DynamicResource Muted}" Margin="0,6,0,14" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="1 · 选择邮件平台" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="邮件平台" Style="{StaticResource LabelText}" Margin="0,12,0,4"/>
                        <ComboBox x:Name="ProviderBox" DisplayMemberPath="Label"
                                  SelectionChanged="ProviderBox_SelectionChanged"
                                  AutomationProperties.Name="邮件平台"/>
                    </StackPanel>
                </Border>

                <Border x:Name="ProviderGuideCard" Style="{StaticResource Card}"
                        Background="{DynamicResource PrimarySurface}" BorderBrush="{DynamicResource PrimarySoft}"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="GuideTitleText" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="{DynamicResource SurfaceElevated}"
                                    BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"
                                    CornerRadius="999" Padding="10,5" Margin="12,0,0,0">
                                <TextBlock x:Name="GuideBadgeText" Foreground="{DynamicResource PrimaryDark}"
                                           FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="GuideSummaryText" Foreground="{DynamicResource InkSecondary}"
                                   Margin="0,9,0,0" TextWrapping="Wrap" LineHeight="20"/>
                        <TextBlock x:Name="GuideStepsText" Foreground="{DynamicResource Ink}"
                                   Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="24"/>
                        <WrapPanel Margin="0,13,0,0">
                            <Button x:Name="ProviderSetupButton" Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,8,6" Click="ProviderSetup_Click"
                                    AutomationProperties.Name="打开平台设置页面"/>
                            <Button x:Name="ProviderHelpButton" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,0,6" Click="ProviderHelp_Click"
                                    AutomationProperties.Name="打开官方连接说明"/>
                        </WrapPanel>
                        <Border Background="{DynamicResource WarningSoft}" BorderBrush="{DynamicResource Warning}"
                                BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,8,0,0">
                            <TextBlock x:Name="GuideCompatibilityText" Foreground="{DynamicResource Warning}"
                                       FontSize="11" TextWrapping="Wrap" LineHeight="18"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="2 · 填写账号资料" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="显示名称" Style="{StaticResource LabelText}" Margin="0,12,0,4"/>
                        <TextBox x:Name="DisplayNameBox" AutomationProperties.Name="显示名称"/>
                        <TextBlock Text="这是客户收到邮件时看到的发件人名称，例如“Frank”或“Sales Team”。"
                                   Style="{StaticResource MicroText}" Margin="0,4,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="邮箱地址" Style="{StaticResource LabelText}" Margin="0,10,0,4"/>
                        <TextBox x:Name="EmailBox" TextChanged="EmailBox_TextChanged"
                                 AutomationProperties.Name="邮箱地址"/>
                        <TextBlock x:Name="EmailHintText" Style="{StaticResource MicroText}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="登录用户名" Style="{StaticResource LabelText}" Margin="0,10,0,4"/>
                        <TextBox x:Name="UserNameBox" TextChanged="UserNameBox_TextChanged"
                                 AutomationProperties.Name="登录用户名"/>
                        <TextBlock x:Name="UserNameHintText" Style="{StaticResource MicroText}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>

                        <TextBlock x:Name="PasswordLabelText" Style="{StaticResource LabelText}" Margin="0,10,0,4"/>
                        <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="邮件连接密码"/>
                        <TextBlock x:Name="PasswordHintText" Foreground="{DynamicResource Warning}"
                                   FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="3 · 确认收发服务器" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="ServerPresetText" Style="{StaticResource MicroText}"
                                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="ResetPresetButton" Grid.Column="1" Content="恢复平台推荐参数"
                                    Style="{StaticResource SecondaryButton}" Padding="12,7" MinHeight="34"
                                    Margin="12,0,0,0" VerticalAlignment="Center" Click="ResetPreset_Click"/>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="95"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="IMAP 主机（收取邮件）" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="ImapHostBox" Margin="0,4,0,0" AutomationProperties.Name="IMAP 主机"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="端口" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="ImapPortBox" Margin="0,4,0,0" AutomationProperties.Name="IMAP 端口"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="ImapSslBox" Content="IMAP 使用 SSL / TLS"
                                  Margin="0,8,0,0" IsChecked="True"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="95"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SMTP 主机（发送邮件）" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="SmtpHostBox" Margin="0,4,0,0" AutomationProperties.Name="SMTP 主机"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="端口" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="SmtpPortBox" Margin="0,4,0,0" AutomationProperties.Name="SMTP 端口"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="SmtpSslBox" Content="SMTP 使用 SSL / TLS 或 STARTTLS"
                                  Margin="0,8,0,0" IsChecked="True"/>

                        <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}"
                                   Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="19"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="DeleteButton" Content="删除账号" Style="{StaticResource DangerButton}" Click="Delete_Click"/>
            <Button Grid.Column="2" Content="取消" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
            <Button Grid.Column="4" x:Name="SaveButton" Content="测试连接并保存"
                    Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>
