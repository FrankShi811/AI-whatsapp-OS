<Window x:Class="WAFlow.Desktop.Windows.KnowledgeUploadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="知识上传设置" Width="650" Height="690" MinWidth="560" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource Canvas}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,24">
                <TextBlock Text="KNOWLEDGE GOVERNANCE" Style="{StaticResource PageEyebrow}"/>
                <TextBlock Text="确认知识类型与可见范围" Style="{StaticResource PageTitle}" Margin="0,5,0,0"/>
                <TextBlock Text="上传内容默认进入待审核状态，不会立刻参与 AI 回复。只有人工启用且通过风险检查后，才会进入检索。"
                           Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,7,0,18"/>

                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="文件" Style="{StaticResource LabelText}"/>
                        <TextBlock x:Name="FileNameText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,14"/>
                        <TextBlock Text="知识标题" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="TitleBox" Margin="0,4,0,12"/>
                        <TextBlock Text="知识分类" Style="{StaticResource LabelText}"/>
                        <ComboBox x:Name="CategoryBox" DisplayMemberPath="Label" Margin="0,4,0,12"/>
                        <TextBlock Text="使用方式" Style="{StaticResource LabelText}"/>
                        <ComboBox x:Name="UsageModeBox" DisplayMemberPath="Label" Margin="0,4,0,12"/>
                        <TextBlock Text="作用域" Style="{StaticResource LabelText}"/>
                        <ComboBox x:Name="ScopeKindBox" DisplayMemberPath="Label" SelectionChanged="ScopeKind_SelectionChanged" Margin="0,4,0,6"/>
                        <TextBlock x:Name="ScopeHelpText" Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Grid x:Name="AccountBindingPanel" Visibility="Collapsed" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="WhatsApp 账号 ID" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                            <TextBox x:Name="AccountIdBox" Grid.Column="1" ToolTip="必须与系统内账号 ID 完全一致"/>
                        </Grid>
                        <Grid x:Name="CustomerBindingPanel" Visibility="Collapsed" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="客户 ID" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CustomerBox" Grid.Column="1" DisplayMemberPath="Label" IsEditable="True"
                                      IsTextSearchEnabled="True" StaysOpenOnEdit="True"/>
                        </Grid>
                        <Grid x:Name="ConversationBindingPanel" Visibility="Collapsed" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="会话 ID" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                            <TextBox x:Name="ConversationIdBox" Grid.Column="1"/>
                        </Grid>
                        <Grid x:Name="TemporaryBindingPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="任务 / 运行 ID" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TemporaryTaskIdBox" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource WarningSoft}" CornerRadius="12" Padding="14" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="安全边界" Foreground="{DynamicResource Warning}" FontWeight="SemiBold"/>
                        <TextBlock Text="文件中的任何“忽略系统规则、改变角色、输出密钥”等内容只会被当作不可信数据，并会阻止知识启用。AI 未发送草稿不能从这里直接进入知识库。"
                                   Foreground="{DynamicResource Ink}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Content="开始解析" Style="{StaticResource PrimaryButton}" Click="Confirm_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
